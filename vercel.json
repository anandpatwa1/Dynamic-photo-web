{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://apinew.duckdns.org/api/v1/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://apinew.duckdns.org/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
